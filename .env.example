# Copy to .env and fill in. `.env` is gitignored; this file is not.
#
# WARNING — nothing in this file is secret.
# Vite inlines every VITE_* variable into the client bundle at build time, so
# whatever you put here ships to the browser in plain text and is readable by
# anyone who views source. Only put values here that are safe to publish.
# Real secrets (API keys, tokens, credentials) must never live in a VITE_*
# variable — they belong in a secrets manager or the OS keychain.

# Formspree form id. This is the public part of a Formspree endpoint
# (https://formspree.io/f/<id>) and is designed to be visible in client code.
# Create a form at https://formspree.io and paste its id here.
VITE_FORMSPREE_ID=
